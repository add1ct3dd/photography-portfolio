{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "lib": [
      "ES2020",
      "DOM",
      "DOM.Iterable"
    ],
    "declaration": true,
    "declarationMap": false,
    "outDir": "./assets/js",
    "rootDir": "./assets/ts",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "moduleResolution": "node",
    "allowSyntheticDefaultImports": true,
    "removeComments": true,
    "noEmit": false,
    "sourceMap": false
  },
  "include": [
    "assets/ts/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "assets/js/**/*.js",
    "_site"
  ]
}